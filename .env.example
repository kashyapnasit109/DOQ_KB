# OpenAI API Key (required for GPT-4o Vision processing)
OPENAI_API_KEY=sk-your-key-here

# Admin PIN for protected settings (optional, default: 1234)
ADMIN_PIN=1234

# Turso Database (required for Vercel deployment, optional for local)
# Get free at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token
